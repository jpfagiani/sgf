[Unit]
Description=SGF - Sistema de Gestao de Frota (CDPNI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sgf
Group=sgf
WorkingDirectory=/opt/sgf
ExecStart=/usr/bin/python3 /opt/sgf/run_sgf.py @PORT@
Restart=always
RestartSec=3
# Permite abrir a porta 80 sem rodar como root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/sgf

[Install]
WantedBy=multi-user.target
